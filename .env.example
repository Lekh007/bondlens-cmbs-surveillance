# Copy to .env and fill in. .env is gitignored; never commit real values.
#
# Not a secret - SEC's fair-access policy wants a real contact string, safe to log.
SEC_USER_AGENT=Vichara-GenAI-Portfolio/0.1 (your-email@example.com)

# The one real secret. Generate locally, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional overrides - defaults in settings.py match Docker Compose service names.
# DATABASE_URL=postgresql+psycopg://vichara:vichara@localhost:5432/vichara
# REDIS_URL=redis://localhost:6379/0
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b
# MODEL_PROVIDER=ollama
# EXTERNAL_NETWORK_ENABLED=false
